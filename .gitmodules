	path = deps/libretro-common
	url = https://github.com/libretro/libretro-common.git
[submodule "deps/pupnp"]
	path = deps/pupnp
	url = https://github.com/mrjimenez/pupnp.git
[submodule "deps/freetype"]
	path = deps/freetype
	url = https://github.com/freetype/freetype.git
[submodule "deps/mbedtls"]
	path = deps/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "deps/libsmb2"]
	path = deps/libsmb2
	url = https://github.com/sahlberg/libsmb2.git
[submodule "deps/FFmpeg"]
	path = deps/FFmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
[submodule "deps/libssh"]
	path = deps/libssh
	url = https://gitlab.com/libssh/libssh-mirror.git
